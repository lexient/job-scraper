# Local postgres host port (compose publishes container 5432 to this port).
# db.py also uses this when DATABASE_URL is not set.
POSTGRES_HOST_PORT=65432

# Override the DB connection (e.g. to point at a remote DB).
# Leave unset for local compose usage.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname


# Scraper config.
# SCRAPE_LIMIT=99999
# SCRAPE_INTERVAL_SECONDS=1800
# CONCURRENCY=8
# REQUEST_DELAY=0.1                 # seconds between per-job requests
# RETRY_WAITS=1,2,4,8,16,32         # backoff schedule (seconds) for blocked responses

# By default, it only tracks ICT listings, you can change `classification_id` 
# in `src/job_scraper/scrape.py` from IDs in `src/job_scraper/seek_taxonomy.json`.
# CLASSIFICATION_ID=6281