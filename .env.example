# Override the DB port
# POSTGRES_HOST_PORT=65432

# Override the DB connection (e.g. to point at a remote DB)
# DATABASE_URL=postgresql://seek:seek@host:5432/postgres

# Override scraper config defaults.
# SCRAPE_LIMIT=99999
# SCRAPE_INTERVAL_SECONDS=1800      # 30min
# CONCURRENCY=8
# REQUEST_DELAY=0.1                 # seconds between per-job requests
# RETRY_WAITS=1,2,4,8,16,32,64        # backoff schedule (seconds) for blocked responses (seek)
# SEARCH_DELAY=1.5                  # seconds between indeed search pages
# HEADLESS=false                    # run indeed's browser headless (less reliable vs cloudflare)

SCRAPE_SOURCE=seek                # seek | indeed | all

# Only tracks ICT listings by default. The master scope for both sources: it
# picks the Seek classification (IDs in `src/job_scraper/seek_taxonomy.json`)
# and the Indeed search terms (`src/job_scraper/indeed_search_terms.json`).
CLASSIFICATION_ID=6281